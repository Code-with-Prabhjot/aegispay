# ==============================================================================
# AegisPay PayPal Sandbox & Platform Environment Configuration
# ==============================================================================

# PayPal REST API Credentials (Developer Sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
# mock = fully offline fake PayPal (no credentials needed); sandbox | live use real PayPal.
# Mock is also used automatically when the client id/secret above are blank or placeholders.
PAYPAL_MODE=mock
# Skips webhook signature verification for local pytest runs. Rejected at startup in live mode.
PAYPAL_WEBHOOK_MOCK_BYPASS=false

# Database Persistence
# SQLite by default; backend/db/schema.sql is Postgres-compatible DDL.
DATABASE_URL=sqlite:///./aegispay.db

# Protocol Fees & Guardrails
PROTOCOL_FEE_BPS=500
PAYPAL_PAYOUT_FEE_MICROS=250000
DAILY_SPEND_LIMIT_MICROS=50000000

# Sandbox Account Topology (Fix #4)
BUYER_SANDBOX_EMAIL=buyer-agent-sandbox@personal.example.com
CLEARINGHOUSE_SANDBOX_EMAIL=aegispay-clearinghouse@business.example.com
WORKER_SANDBOX_EMAIL=worker-agent-alpha@personal.example.com


# Arbiter sandbox and semantic judge
SANDBOX_MODE=auto
SANDBOX_IMAGE=aegispay-sandbox-runner:latest
LLM_JUDGE_ENABLED=false
LLM_JUDGE_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=your_anthropic_api_key_here
