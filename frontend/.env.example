# Keep REST calls on the dashboard's origin so the server can add the API key.
NEXT_PUBLIC_API_BASE=/api/v1
# Set this before building when the backend is hosted elsewhere (e.g. Render).
BACKEND_URL=http://127.0.0.1:8000
# Match the backend's API_AUTH_KEY. Never use a NEXT_PUBLIC_ variable for this secret.
API_AUTH_KEY=
# Optional direct WebSocket endpoint for hosts whose HTTP proxy cannot upgrade connections.
# NEXT_PUBLIC_WS_URL=wss://your-backend.example.com
# Add the dashboard's origin to the backend's CORS_ALLOWED_ORIGINS for direct WebSockets.
