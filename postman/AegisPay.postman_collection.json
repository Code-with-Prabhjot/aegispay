    {
      "name": "Ledger",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/ledger",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ledger"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.expect([200]).to.include(pm.response.code); });",
              "const j = pm.response.json();",
              "pm.test('entries + balances', function () { pm.expect(j.entries).to.be.an('array'); pm.expect(j.balances).to.be.an('object'); });",
              "pm.test('balanced', function () { pm.expect(j.balanced).to.eql(true); });"
            ]
          }
        }
