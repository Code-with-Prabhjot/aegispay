    {
      "name": "PayPal webhook (payout succeeded)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/webhooks/paypal",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "webhooks",
            "paypal"
          ]
        },
        "description": "In mock mode signatures are accepted; unknown batch ids return status ignored_unknown_payout. Use a payout_batch_id from a contract in PAYOUT_DISPATCHED.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"WH-POSTMAN-1\",\n  \"event_type\": \"PAYMENT.PAYOUTS-ITEM.SUCCEEDED\",\n  \"resource\": {\n    \"payout_batch_id\": \"MOCKPAYOUT-UNKNOWN\",\n    \"transaction_status\": \"SUCCESS\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200/401', function () { pm.expect([200, 401]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    }
  ],
