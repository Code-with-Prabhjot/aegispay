{
  "info": {
    "_postman_id": "aegispay-collection-v2",
    "name": "AegisPay Collection v2.0 - Best Demo Delivery",
    "description": "Official Postman Collection v2 for AegisPay - Autonomous Agent Escrow & Verified Settlement Engine with PayPal Vaulting v3, Ed25519 A2A Handshake, AST Hard Veto Sandbox, 7-Leaf Merkle Audit Trees, and Integer Double-Entry Ledger Invariants.",
