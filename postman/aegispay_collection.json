  },
  "item": [
    {
      "name": "Folder 1: Health & Manifest",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "System health probe checking backend service, SQLite database connectivity, and zero-imbalance ledger invariant."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Health status is ok\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.status).to.eql(\"ok\");",
                  "});",
                  "",
                  "pm.test(\"Database is connected\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.database).to.eql(\"connected\");",
                  "});",
                  "",
                  "pm.test(\"Double-entry ledger is balanced\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.ledger_balanced).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/mcp/manifest",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mcp/manifest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "mcp",
                "manifest"
              ]
            },
            "description": "Model Context Protocol (MCP) server manifest exposing AegisPay autonomous escrow capabilities to Claude/LLM agents."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Manifest exposes tools\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.tools).to.be.an(\"array\");",
                  "    pm.expect(data.tools.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Defines core AegisPay autonomous tools\", function () {",
                  "    var data = pm.response.json();",
                  "    var toolNames = data.tools.map(function(t) { return t.name; });",
                  "    pm.expect(toolNames).to.include(\"aegispay_propose_agreement\");",
                  "    pm.expect(toolNames).to.include(\"aegispay_submit_deliverable\");",
                  "    pm.expect(toolNames).to.include(\"aegispay_check_escrow_status\");",
                  "});"
