    {
      "name": "Folder 2: Agent Identity & A2A Negotiation",
      "item": [
        {
          "name": "POST /api/v1/a2a/verify-identity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"public_key_hex\": \"723a821dda9fea220ba9bf00be00e9a9931a4a8edf0ed2ca9a342ffaad9b9c12\",\n  \"challenge\": {\n    \"session\": \"aegispay_m2m_session_2026\",\n    \"timestamp\": \"2026-11-06T12:00:00Z\"\n  },\n  \"signature_hex\": \"dc3f8a2efbfb0dfa7ec43b0e02c6d01546f0555f04b0a8bcd4f33290d087150be1812f259ebcc69159d3ceced4a089bdc66a890203f0e2a6943b79df1113ed06\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/a2a/verify-identity",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "a2a",
                "verify-identity"
              ]
            },
            "description": "Cryptographic Ed25519 M2M agent identity verification. Validates detached signature over canonical JSON challenge payload."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Signature cryptographically verified\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.valid).to.eql(true);",
                  "    pm.expect(data.verified).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Agent DID verified\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.agent_id).to.include(\"did:key:\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/a2a/negotiate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buyer_pref\": {\n    \"max_budget_micros\": 15000000,\n    \"max_timeout_seconds\": 8.0\n  },\n  \"worker_pref\": {\n    \"min_budget_micros\": 5000000,\n    \"min_timeout_seconds\": 2.0\n  },\n  \"alpha\": 0.5,\n  \"beta\": 0.5,\n  \"auto_sign\": true,\n  \"buyer_agent_id\": \"{{buyer_did}}\",\n  \"worker_agent_id\": \"{{worker_did}}\",\n  \"task_description\": \"Implement optimal routing microservice with 100% test pass rate\",\n  \"runtime_language\": \"python\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/a2a/negotiate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "a2a",
                "negotiate"
              ]
            },
            "description": "Bilateral Nash Bargaining solution for SLA terms. Solves Pareto-optimal budget and deadline, generates dual-signed SLA contract and locks PayPal authorization hold."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Negotiation reached agreement\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.status).to.eql(\"AGREEMENT_REACHED\");",
                  "});",
                  "",
                  "pm.test(\"Nash utility converged on Pareto frontier\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.nash_product).to.be.above(0);",
                  "    pm.expect(data.buyer_utility).to.be.above(0);",
                  "    pm.expect(data.worker_utility).to.be.above(0);",
                  "    pm.expect(data.agreed_budget_micros).to.be.within(5000000, 15000000);",
                  "});",
                  "",
                  "pm.test(\"Saves agreement_id to environment\", function () {",
                  "    var data = pm.response.json();",
                  "    var aid = data.agreement_id || (data.offer && data.offer.contract_id);",
                  "    pm.expect(aid).to.be.ok;",
                  "    pm.environment.set(\"agreement_id\", aid);",
                  "    if (data.auth_id) {",
                  "        pm.environment.set(\"auth_id\", data.auth_id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
